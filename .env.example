# Home Assistant (read-only)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token

# MQTT — broker déjà utilisé par Home Assistant (pas de Mosquitto embarqué)
MQTT_HOST=core-mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=house
# MQTT discovery (HA sensors under device « Hass Agents ») — default on
MQTT_DISCOVERY=true
MQTT_DISCOVERY_PREFIX=homeassistant

# Infomaniak AI Tools (OpenAI-compatible)
# Leave OPENAI_API_KEY empty to run heuristic reports only (no LLM).
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.infomaniak.com/2/ai/PRODUCT_ID/openai/v1
# Infomaniak model id. CrewAI prefixes openai/ automatically for custom base URLs
# (avoids treating "google/..." as Google GenAI).
LLM_MODEL=google/gemma-4-31B-it
INFOMANIAK_PRODUCT_ID=

# Anomaly thresholds
ZSCORE_WARN=2.0
ZSCORE_CRITICAL=3.0
DELTA_PCT_WARN=25.0
DELTA_PCT_CRITICAL=50.0
COMFORT_BASE_TEMP=18.0

# Path to entity mapping (relative to repo root or absolute)
ENTITIES_CONFIG=config/entities.yaml
